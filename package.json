{
  "name": "relay-dsh-plugin-codex",
  "version": "0.2.4-mavis.2",
  "description": "Codex conversation backend for DeepSeek Harness, powered by the Codex App Server with approvals and DSH tool support. (reknottycat build: DSH 0.1.7-rc.2 adaptation, see PATCHES.md)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-codex.git"
  },
  "homepage": "https://github.com/yangbobo2021/relay-dsh-plugin-codex#readme",
  "bugs": {
    "url": "https://github.com/yangbobo2021/relay-dsh-plugin-codex/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh.md",
    "docs/images",
    "docs/reliability-spec.md",
    "docs/reliability-acceptance.md",
    "docs/spec/dsh-interaction-bridge.md",
    "docs/spec/execution-presentation.md",
    "scripts/repair-activity-history.mjs",
    "codex-activity-wire.mjs",
    "cordis.patch.yml",
    "presets",
    "lib/client.js",
    "lib/host-plugin.js",
    "lib/host-plugin.js.map",
    "lib/typert.host.js",
    "lib/typert.host.js.map",
    "docs/dsh-0.1.2-alpha.3.md",
    "dsh-compat.mjs",
    "dsh-client-compat.mjs",
    "dsh-client-compat.d.mts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "relay-dsh-plugin-session-import",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@openai/codex": "0.155.1",
    "lucide-react": "^1.37.0",
    "relay-dsh-plugin-session-import": "0.2.3"
  },
  "scripts": {
    "test": "node --test scripts/settings-compat.test.mjs",
    "note": "prebuilt distribution - see PATCHES.md"
  }
}
